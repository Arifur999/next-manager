# Server-side route to the backend API, read at runtime by src/env.ts.
# Development defaults to http://localhost:5000/api/v1; production must set it.
# API_INTERNAL_URL is still accepted as a deprecated alias.
API_BASE_URL=http://localhost:5000/api/v1

# Browser route to the API, used only by the chat socket until it moves to the page origin.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# Must match the backend's ACCESS_TOKEN_SECRET exactly: src/proxy.ts verifies
# the access token locally before letting a protected route render.
JWT_ACCESS_SECRET=change_this_access_secret

# Public origin of this site, for absolute links and metadata. Development defaults to http://localhost:3000.
SITE_URL=http://localhost:3000

# debug | info | warn | error (default info)
LOG_LEVEL=info
